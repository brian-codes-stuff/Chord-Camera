{
  "expo": {
    "name": "Chord Camera",
    "slug": "chord-camera",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brianalonzo.chordcamera",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Chord Camera uses the camera to capture chord charts so you can transpose them.",
        "NSPhotoLibraryUsageDescription": "Chord Camera reads chord charts from your photo library so you can transpose them."
      }
    },
    "android": {
      "package": "com.brianalonzo.chordcamera",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Chord Camera reads chord charts from your photo library.",
          "cameraPermission": "Chord Camera uses the camera to capture chord charts."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6177580188526680~8974280579",
          "iosAppId": "ca-app-pub-6177580188526680~3593736042"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier is used to deliver more relevant ads, which keeps Chord Camera free."
        }
      ]
    ],
    "owner": "brian-alonzo-web-design-and-development",
    "extra": {
      "eas": {
        "projectId": "f0973900-0440-428e-aef4-1293ddc94c13"
      }
    }
  }
}
